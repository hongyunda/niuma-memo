APP_DEBUG = false

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = niuma_memo
DB_USER = memo
DB_PASS =
DB_PORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX =

; 站点对外地址（推送深链、ASR 临时下载链接会用到）
APP_URL = http://localhost:5173

; JWT：请改成 32 位以上随机串
JWT_SECRET =
JWT_TTL = 604800
JWT_COOKIE = memo_token

; 附件
UPLOAD_STORAGE = local
COS_BUCKET =
COS_REGION =
COS_SECRET_ID =
COS_SECRET_KEY =
COS_PREFIX = memo
UPLOAD_MAX_MB = 200
; 生产环境配合 Nginx internal location 输出私有文件（见 deploy/nginx.conf），开发环境 false
UPLOAD_ACCEL = false
UPLOAD_ACCEL_PREFIX = /_protected

; 可选 AI 服务：配置兼容接口地址、自己的 API Key 与模型名称
AI_BASE_URL = https://ark.cn-beijing.volces.com/api/coding/v3
AI_API_KEY =
AI_MODEL = ark-code-latest
AI_VISION_MODEL =
AI_TIMEOUT = 120

; Web Push VAPID（php think push:vapid 生成）
VAPID_PUBLIC =
VAPID_PRIVATE =
VAPID_SUBJECT = "mailto:admin@example.com"

; 语音转文字：tencent | volcengine | none
ASR_PROVIDER = none
TENCENT_SECRET_ID =
TENCENT_SECRET_KEY =
TENCENT_ASR_ENGINE = 16k_zh
VOLC_APP_KEY =
VOLC_ACCESS_KEY =
VOLC_RESOURCE_ID = volc.bigasr.auc_turbo

; ffmpeg（用于 webm 转 mp3、读取音视频时长），留空则自动从 PATH 查找
FFMPEG_BIN =
FFPROBE_BIN =
