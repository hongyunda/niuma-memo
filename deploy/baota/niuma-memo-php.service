[Unit]
Description=Niuma Memo PHP-FPM
After=network.target

[Service]
Type=simple
ExecStart=/www/server/php/82/sbin/php-fpm -F -c /www/server/php/82/etc/php-cli.ini -y /srv/niuma-memo/deploy/php-fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5s
KillSignal=SIGQUIT
TimeoutStopSec=310s

[Install]
WantedBy=multi-user.target
